# ==============================================================================
# SIMPATI LICENSE MANAGER - Environment Variables Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME="SIMPATI License Manager"
APP_VERSION=1.0.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & Secrets (Ganti dengan string rahasia acak 64 karakter di lingkungan produksi)
# Contoh generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL Dedicated untuk License Manager)
# JANGAN arahkan ke database produksi SIMPATI 555!
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=simpati_license_db
DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# License Validation & Grace Period Rules
DEFAULT_GRACE_PERIOD_DAYS=7
TOKEN_VALIDATION_INTERVAL_HOURS=24
ALLOW_RESTRICTED_MODE=true

# Ed25519 License Signing Keys
# Di produksi, simpan path file atau vault reference, jangan pernah commit private key!
SIGNING_KEY_VAULT_PATH=secrets/keys/simpati_ed25519_root.key
SIGNING_KEY_IDENTIFIER=KEY-SIMPATI-ROOT-V1

# CORS Settings (Daftar domain yang diizinkan, pisahkan dengan koma)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
