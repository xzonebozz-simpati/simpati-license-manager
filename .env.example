# ==============================================================================
# SIMPATI LICENSE MANAGER - Environment Variables Configuration
# Template Konfigurasi untuk Local, Staging (Hostless + Supabase), dan Produksi
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Binding
# ------------------------------------------------------------------------------
# Set "staging" atau "production" di cloud
APP_ENV=staging
APP_NAME="SIMPATI License Manager"
APP_VERSION=1.1.0
APP_DEBUG=false
APP_HOST=0.0.0.0

# PORT diatur otomatis oleh platform Hostless (jangan di-hardcode jika di Hostless)
PORT=8000
APP_PORT=8000

# ------------------------------------------------------------------------------
# 2. Database PostgreSQL Supabase
# ------------------------------------------------------------------------------
# PENTING: Gunakan dedicated PostgreSQL database Supabase untuk License Manager.
# JANGAN campurkan dengan database aplikasi SIMPATI 555!
#
# Opsi A: Supabase Connection String (Direct - Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Opsi B: Supabase Connection Pooler / PgBouncer (Port 6543)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Opsi C: Local Development (SQLite)
DATABASE_URL=sqlite:///./simpati_license.db

# Database Connection Pool Tuning (Optimal untuk Supabase PgBouncer & Hostless)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 3. Security, Token & CSRF
# ------------------------------------------------------------------------------
# Generate string acak minimal 32 karakter (disarankan 64 karakter):
# python -c "import secrets; print(secrets.token_hex(32))"
# Isi dengan nilai acak unik minimal 32 karakter; placeholder ini tidak dapat dipakai di production.
SECRET_KEY=CHANGE-ME-TO-A-UNIQUE-RANDOM-SECRET-AT-LEAST-32-CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Otomatis True jika APP_ENV=staging/production
# COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 4. Kunci Kriptografi Digital Signature Ed25519 (MANDATORY FOR M2M)
# ------------------------------------------------------------------------------
# Di cloud (Hostless), simpan PEM string langsung di Environment Secret dashboard.
# JANGAN PERNAH COMMIT PRIVATE KEY KE GIT!
#
# Cara generate keypair PEM baru untuk env var:
# python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; k = Ed25519PrivateKey.generate(); print(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode().replace('\n', '\\n'))"
#
# Masukkan output string di bawah (atau satu baris dengan \n di dashboard Hostless):
# ED25519_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEI...\n-----END PRIVATE KEY-----"
# ED25519_PUBLIC_KEY_PEM=""  # Opsional: otomatis diderivasi dari private key jika dikosongkan

# Fallback path jika berjalan lokal menggunakan file vault:
SIGNING_KEY_VAULT_PATH=secrets/keys/simpati_ed25519_root.key
SIGNING_KEY_IDENTIFIER=KEY-SIMPATI-ROOT-V1

# ------------------------------------------------------------------------------
# 5. Kredensial Akun Default Superadmin
# ------------------------------------------------------------------------------
# Digunakan saat database baru pertama kali diinisialisasi
ADMIN_USERNAME=superadmin
# Isi dengan password unik minimal 16 karakter sebelum menjalankan staging/production.
ADMIN_PASSWORD=CHANGE-ME-TO-A-UNIQUE-ADMIN-PASSWORD
ADMIN_EMAIL=superadmin@simpati555.id
ADMIN_FULL_NAME="SIMPATI License Superadmin"

# ------------------------------------------------------------------------------
# 6. Proxy Trust & CORS Networking
# ------------------------------------------------------------------------------
# Hostless menggunakan reverse proxy SSL termination. Nilai '*' mempercayai header forwarder.
FORWARDED_ALLOW_IPS=*

# Domain SIMPATI 555 atau dashboard yang diizinkan mengakses CORS (pisahkan dengan koma)
CORS_ORIGINS=https://simpati.id,https://admin.simpati.id,http://localhost:8000
